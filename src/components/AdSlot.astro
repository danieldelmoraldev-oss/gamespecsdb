---
// Manual ad unit. Renders only with a real ad unit id from AdSense (Ads → By ad unit);
// until then Auto ads decide the placements, so no empty gaps are left on the page.
import { SITE } from '../site';
interface Props { slot?: string }
const { slot } = Astro.props;
---
{SITE.adsenseClient && slot ? (
  <div class="ad-slot">
    <ins class="adsbygoogle" style="display:block" data-ad-client={SITE.adsenseClient} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
) : null}
