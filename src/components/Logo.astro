---
// Cartridge outline with three spec bars: "game" + "data".
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <path d="M10 2h15a4 4 0 0 1 4 4v20a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V9z" fill="var(--brand)" />
  <rect x="9" y="12" width="14" height="3" rx="1.5" fill="var(--on-brand)" />
  <rect x="9" y="17.5" width="10" height="3" rx="1.5" fill="var(--on-brand)" opacity=".85" />
  <rect x="9" y="23" width="6" height="3" rx="1.5" fill="var(--on-brand)" opacity=".7" />
</svg>
