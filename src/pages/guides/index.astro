---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
const guides = (await getCollection('guides')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---
<Base title="Switch 2 guides" description="Plain-English guides to Switch 2 storage, Game-Key Cards, microSD Express cards, upgrade packs and performance.">
  <h1>Guides</h1>
  <p class="lead">Short, sourced answers to the questions Switch 2 owners ask most.</p>
  <div class="grid">
    {guides.map((g) => (
      <a class="card" href={`/guides/${g.id}/`}>
        <span class="badges"><span class="badge brand"><Icon name="book" size={14} /> Guide</span></span>
        <span class="title">{g.data.title}</span>
        <span class="muted small">{g.data.description}</span>
      </a>
    ))}
  </div>
</Base>
