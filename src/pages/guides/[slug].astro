---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { formatDate } from '../../lib/games';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}
const { guide } = Astro.props as { guide: CollectionEntry<'guides'> };
const { Content } = await render(guide);
---
<Base title={guide.data.title} description={guide.data.description}>
  <div class="breadcrumbs"><a href="/guides/">Guides</a> › {guide.data.title}</div>
  <article class="prose">
    <h1>{guide.data.title}</h1>
    <p class="small muted">Updated {formatDate(guide.data.updated)}</p>
    <Content />
  </article>
  <AdSlot />
</Base>
