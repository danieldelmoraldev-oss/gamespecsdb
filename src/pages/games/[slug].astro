---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import GameCard from '../../components/GameCard.astro';
import FormatBadge from '../../components/FormatBadge.astro';
import SizeMeter from '../../components/SizeMeter.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../site';
import { allGames, FORMAT_LABEL, KIND_LABEL, formatGB, formatDate, lastChecked, shortTitle, isUpcoming, maxFps, type Game } from '../../lib/games';
import { LISTS } from '../../lib/lists';

export async function getStaticPaths() {
  const games = await allGames();
  return games.map((game) => ({ params: { slug: game.id }, props: { game, games } }));
}

interface Props { game: Game; games: Game[] }
const { game, games } = Astro.props;
const d = game.data;
const INTERNAL_GB = 256;
const share = Math.round((d.fileSize.currentGB / INTERNAL_GB) * 100);
const perf = d.performance;
const checked = lastChecked(game);
const name = shortTitle(d.title);
const upcoming = isUpcoming(d.releaseDate);
const e = d.eshop;
const playerBits = e && [
  e.players.system && `${e.players.system} players on one console`,
  e.players.local && `${e.players.local} over local wireless`,
  e.players.online && `${e.players.online} online`,
].filter(Boolean);
const hasPerf = Boolean(perf?.modes.length);
const PLAY_LABEL = { tv: 'TV mode', handheld: 'Handheld mode', all: 'TV and handheld' } as const;
const modeLabel = (m: NonNullable<typeof perf>['modes'][number]) => `${PLAY_LABEL[m.play]}${m.preset ? ` (${m.preset})` : ''}`;
const modeSpec = (m: NonNullable<typeof perf>['modes'][number]) =>
  [m.resolution, m.fps && `${m.fps} FPS`].filter(Boolean).join(' · ');
const topics = d.kind === 'free-update'
  ? (hasPerf ? 'free upgrade, file size and performance' : 'free upgrade and file size')
  : hasPerf ? 'file size, cartridge and performance' : 'file size and cartridge format';
const lead = d.summary ?? [
  `${d.title} is published by ${d.publisher} and ${upcoming ? 'is due out on' : 'came out on'} ${formatDate(d.releaseDate)}.`,
  playerBits && playerBits.length > 0 ? `Multiplayer: up to ${playerBits.join(', ')}.` : '',
  e && e.languages.length > 0 ? `The eShop lists ${e.languages.length} supported languages.` : '',
].filter(Boolean).join(' ');

const formatAnswer: Record<typeof d.physical.format, string> = {
  'full-cartridge': `The physical release of ${name} has the full game on the cartridge, so you can play it without downloading the game first.`,
  'game-key-card': `The physical release of ${name} is a Game-Key Card: the cartridge only unlocks a ${formatGB(d.fileSize.currentGB)} download, so you need an internet connection and free storage to play it.`,
  'digital-only': `${name} is only sold digitally, so it always needs ${formatGB(d.fileSize.currentGB)} of free storage.`,
  'switch-1-cartridge': `${name} is a Switch 1 game, so it is sold on a regular Switch 1 cartridge, not a Game-Key Card. The cartridge works in a Switch 2.`,
  unknown: `We have not confirmed yet whether the physical release of ${name} is a full cartridge or a Game-Key Card.`,
};

const faqs = [
  {
    q: `How big is ${name} on Switch 2?`,
    a: `${name} ${d.fileSize.estimate ? 'is expected to need' : 'needs'} ${formatGB(d.fileSize.currentGB)} of storage${d.fileSize.launchGB ? ` (it was ${formatGB(d.fileSize.launchGB)} at launch)` : ''}. That is about ${share}% of the Switch 2's ${INTERNAL_GB} GB internal storage.`,
  },
  { q: `Is ${name} a Game-Key Card?`, a: formatAnswer[d.physical.format] },
];
if (perf?.modes.some((m) => m.fps)) {
  const parts = perf.modes
    .filter((m) => m.fps)
    .map((m) => `${m.fps} FPS in ${modeLabel(m).replace('mode (', 'mode, ').replace(')', ' preset')}${m.resolution ? ` at ${m.resolution.replace(/^(Up to|About)/, (w) => w.toLowerCase())}` : ''}`);
  const top = Math.max(...perf.modes.map((m) => m.fps ?? 0));
  faqs.push({
    q: `Does ${name} run at ${top >= 120 ? '120' : '60'} FPS on Switch 2?`,
    a: `${top >= 60 ? 'Yes.' : 'No.'} ${name} targets ${parts.join('; ')}.${perf.note ? ` ${perf.note}` : ''}`,
  });
}
if (d.kind === 'free-update') {
  faqs.push({
    q: `Is there a free Switch 2 upgrade for ${name}?`,
    a: `Yes. ${name} is a Switch 1 game that received a free update for Switch 2. You do not need to buy anything: update the game on your Switch 2 to get the improvements.`,
  });
} else if (d.upgrade) {
  faqs.push({
    q: `How much is the ${name} Nintendo Switch 2 Edition upgrade?`,
    a: d.upgrade.priceUSD === 0 ? 'The upgrade is free.' : `The upgrade costs $${d.upgrade.priceUSD.toFixed(2)} in the US eShop.`,
  });
}

const inLists = LISTS.filter((l) => l.filter(game) && !l.sort);
const samePublisher = games.filter((g) => g.data.publisher === d.publisher && g.id !== game.id).slice(0, 4);
// Games of a similar size keep people browsing (and comparing) instead of leaving.
const similarSize = games
  .filter((g) => g.id !== game.id && !samePublisher.includes(g))
  .sort((a, b) => Math.abs(a.data.fileSize.currentGB - d.fileSize.currentGB) - Math.abs(b.data.fileSize.currentGB - d.fileSize.currentGB))
  .slice(0, 4);
const topFps = maxFps(game);
const FORMAT_HINT: Record<typeof d.physical.format, string> = {
  'full-cartridge': 'Plays from the cartridge, no full download needed',
  'game-key-card': 'The cartridge only unlocks a download',
  'digital-only': 'No physical release',
  'switch-1-cartridge': 'Switch 1 game card; works in a Switch 2',
  unknown: 'Not confirmed yet',
};

const title = d.kind === 'free-update'
  ? `${name} on Switch 2: ${hasPerf ? 'free upgrade, file size and FPS' : 'free upgrade and file size'}`
  : `${name} ${d.kind === 'edition' ? 'Switch 2 Edition' : 'Switch 2'} ${hasPerf ? 'file size, Game-Key Card and FPS' : 'file size and Game-Key Card'}`;
const description = `${name} ${d.fileSize.estimate ? "is expected to take" : "takes"} ${formatGB(d.fileSize.currentGB)} on Switch 2. ${FORMAT_LABEL[d.physical.format]}. Sourced specs, last checked ${formatDate(checked)}.`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: d.title,
    publisher: { '@type': 'Organization', name: d.publisher },
    datePublished: d.releaseDate,
    gamePlatform: 'Nintendo Switch 2',
    genre: d.genres,
    url: `${SITE.url}/games/${game.id}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Games', item: `${SITE.url}/games/` },
      { '@type': 'ListItem', position: 2, name: d.title, item: `${SITE.url}/games/${game.id}/` },
    ],
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="breadcrumbs"><a href="/games/">Games</a> › {name}</div>
  <div class="game-head">
    <h1>{name}{d.kind === 'edition' ? ' (Switch 2 Edition)' : ''} on Switch 2: {topics}</h1>
    <div class="badges">
      <FormatBadge format={d.physical.format} />
      {topFps > 0 && <span class="badge brand">Up to {topFps} FPS</span>}
      {d.kind === 'edition' && <span class="badge">Switch 2 Edition</span>}
      {upcoming && <span class="badge digital">Coming {formatDate(d.releaseDate)}</span>}
    </div>
  </div>
  <p class="lead">{lead}</p>

  <div class="tiles">
    <div class="tile">
      <div class="label">{d.fileSize.estimate ? 'Estimated size' : d.kind === 'free-update' ? 'File size (Switch 1 game)' : 'File size'}</div>
      <div class="value">{formatGB(d.fileSize.currentGB)}</div>
      <SizeMeter gb={d.fileSize.currentGB} />
      <div class="hint">{share}% of the {INTERNAL_GB} GB internal storage</div>
    </div>
    <div class="tile">
      <div class="label">Physical release</div>
      <div class="value sm">{FORMAT_LABEL[d.physical.format]}</div>
      <div class="hint">{FORMAT_HINT[d.physical.format]}</div>
    </div>
    {topFps > 0 && (
      <div class="tile">
        <div class="label">Frame rate</div>
        <div class="value">Up to {topFps} FPS</div>
        <div class="hint">See modes below</div>
      </div>
    )}
    {d.upgrade && (
      <div class="tile">
        <div class="label">Switch 2 upgrade</div>
        <div class="value">{d.upgrade.priceUSD === 0 ? 'Free' : `$${d.upgrade.priceUSD.toFixed(2)}`}</div>
        <div class="hint">{d.kind === 'free-update' ? 'Free update for the Switch 1 game' : 'If you own the Switch 1 game'}</div>
      </div>
    )}
  </div>
  <p class="small muted">Last checked {formatDate(checked)} · every figure links to its source</p>

  <div class="layout-2">
    <div>
      <h2>Specs</h2>
      <div class="table-scroll">
        <table class="specs">
          <tbody>
            <tr><th>{d.fileSize.estimate ? 'File size (estimated)' : 'File size (current)'}</th><td>{formatGB(d.fileSize.currentGB)}<a class="src" href={d.fileSize.source} rel="nofollow noopener">source</a></td></tr>
            {d.fileSize.launchGB && <tr><th>File size at launch</th><td>{formatGB(d.fileSize.launchGB)}</td></tr>}
            <tr><th>Physical format</th><td>{FORMAT_LABEL[d.physical.format]}{d.physical.note && <span class="muted"> ({d.physical.note})</span>}<a class="src" href={d.physical.source} rel="nofollow noopener">source</a></td></tr>
            <tr><th>Type</th><td>{KIND_LABEL[d.kind]}</td></tr>
            {perf?.modes.map((m) => (
              <tr><th>{modeLabel(m)}</th><td>{modeSpec(m)}<a class="src" href={perf.source} rel="nofollow noopener">source</a></td></tr>
            ))}
            {perf?.note && <tr><th>Performance note</th><td>{perf.note}</td></tr>}
            {d.upgrade && <tr><th>{d.kind === 'free-update' ? 'Switch 2 update' : 'Switch 2 Edition upgrade'}</th><td>{d.upgrade.priceUSD === 0 ? 'Free' : `$${d.upgrade.priceUSD.toFixed(2)}`}<a class="src" href={d.upgrade.source} rel="nofollow noopener">source</a></td></tr>}
            {e?.switch1SizeGB && <tr><th>Switch 1 version size</th><td>{formatGB(e.switch1SizeGB)}</td></tr>}
            {e?.priceUSD != null && <tr><th>US eShop price</th><td>${e.priceUSD.toFixed(2)}</td></tr>}
            {e && e.playModes.length > 0 && <tr><th>Play modes</th><td>{e.playModes.join(', ')}</td></tr>}
            {playerBits && playerBits.length > 0 && <tr><th>Multiplayer</th><td>Up to {playerBits.join(' · ')}</td></tr>}
            {e && e.languages.length > 0 && <tr><th>Languages ({e.languages.length})</th><td>{e.languages.join(', ')}</td></tr>}
            <tr><th>Publisher</th><td>{d.publisher}</td></tr>
            {e?.developer && e.developer !== d.publisher && <tr><th>Developer</th><td>{e.developer}</td></tr>}
            <tr><th>Release date</th><td>{formatDate(d.releaseDate)}</td></tr>
            {d.genres.length > 0 && <tr><th>Genre</th><td>{d.genres.join(', ')}</td></tr>}
          </tbody>
        </table>
      </div>

      <AdSlot />

      <h2>Questions</h2>
      <div class="faq">
        {faqs.map((f) => (
          <section>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </section>
        ))}
      </div>
    </div>

    <aside class="panel aside-box">
      <h2>Will it fit?</h2>
      <p class="small muted">Add {name} and your other games to see if they fit on 256 GB or a microSD Express card.</p>
      <p><a href="/tools/storage-calculator/"><Icon name="storage" size={16} /> Open the storage calculator</a></p>
      {inLists.length > 0 && (
        <>
          <h2>Appears in</h2>
          <ul>{inLists.map((l) => <li><a href={`/lists/${l.slug}/`}>{l.title}</a></li>)}</ul>
        </>
      )}
      <h2>Learn more</h2>
      <ul>
        <li><a href="/guides/what-is-a-game-key-card/">What is a Game-Key Card?</a></li>
        <li><a href="/guides/switch-2-microsd-express-cards/">microSD Express cards</a></li>
      </ul>
    </aside>
  </div>

  {samePublisher.length > 0 && (
    <>
      <div class="section-head"><h2>More from {d.publisher}</h2></div>
      <div class="grid games">{samePublisher.map((g) => <GameCard game={g} />)}</div>
    </>
  )}

  <div class="section-head"><h2>Games of a similar size</h2><a href="/lists/largest-games/">Size ranking</a></div>
  <div class="grid games">{similarSize.map((g) => <GameCard game={g} />)}</div>
</Base>
