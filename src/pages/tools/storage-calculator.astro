---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import { allGames } from '../../lib/games';
const games = (await allGames()).map((g) => ({ id: g.id, title: g.data.title, gb: g.data.fileSize.currentGB }));
---
<Base title="Switch 2 storage calculator: how many games fit?" description="Pick your Switch 2 games and a microSD Express card size to see how much storage you need and how many games fit.">
  <h1>Switch 2 storage calculator</h1>
  <p class="lead">Tick the games you want installed and pick a microSD Express card. The Switch 2 has 256 GB of internal storage; the system reserves part of it, so leave some margin.</p>

  <label for="card"><strong>microSD Express card</strong></label>
  <select id="card">
    <option value="0">No card (internal storage only)</option>
    <option value="128">128 GB card</option>
    <option value="256" selected>256 GB card</option>
    <option value="512">512 GB card</option>
    <option value="1024">1 TB card</option>
    <option value="2048">2 TB card</option>
  </select>

  <div class="answer" aria-live="polite">
    <p><strong id="used">0 GB</strong> selected of <strong id="total">512 GB</strong> total.</p>
    <p id="verdict" class="muted">Select games below.</p>
  </div>

  <AdSlot />

  <input type="search" id="filter" placeholder="Filter games" aria-label="Filter games" />
  <div class="table-scroll">
    <table id="games">
      <thead><tr><th>Install</th><th>Game</th><th>Size</th></tr></thead>
      <tbody>
        {games.map((g) => (
          <tr data-search={g.title.toLowerCase()}>
            <td><input type="checkbox" value={g.gb} aria-label={`Install ${g.title}`} /></td>
            <td><a href={`/games/${g.id}/`}>{g.title}</a></td>
            <td>{g.gb < 1 ? `${Math.round(g.gb * 1024)} MB` : `${g.gb.toFixed(1)} GB`}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script>
    const INTERNAL = 256;
    const card = document.getElementById('card') as HTMLSelectElement;
    const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('#games input[type=checkbox]'));
    const fmt = (gb: number) => (gb >= 1024 ? `${(gb / 1024).toFixed(2)} TB` : `${gb.toFixed(1)} GB`);
    function update() {
      const total = INTERNAL + Number(card.value);
      const used = boxes.filter((b) => b.checked).reduce((s, b) => s + Number(b.value), 0);
      document.getElementById('used')!.textContent = fmt(used);
      document.getElementById('total')!.textContent = fmt(total);
      const free = total - used;
      document.getElementById('verdict')!.textContent =
        used === 0 ? 'Select games below.'
        : free >= 0 ? `Everything fits, with ${fmt(free)} to spare.`
        : `You are ${fmt(-free)} short. Pick a bigger card or fewer games.`;
    }
    card.addEventListener('change', update);
    boxes.forEach((b) => b.addEventListener('change', update));
    const filter = document.getElementById('filter') as HTMLInputElement;
    filter.addEventListener('input', () => {
      const q = filter.value.trim().toLowerCase();
      document.querySelectorAll<HTMLTableRowElement>('#games tbody tr').forEach((r) => {
        r.hidden = q !== '' && !r.dataset.search!.includes(q);
      });
    });
    update();
  </script>
</Base>
